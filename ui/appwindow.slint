import { LcdDisplay } from "lcd_display.slint";
import { Keypad } from "keypad.slint";
import { PaperTape, TapeItem } from "paper_tape.slint";

export component AppWindow inherits Window {
    title: "Heptaseg";
    icon: @image-url("");
    min-width: 330px;
    min-height: 490px;
    background: #1e2025;
    default-font-family: "sans-serif";

    in property <[string]> digits: [" ", " ", " ", " ", " ", " ", " ", "0"];
    in property <[bool]> decimals: [false, false, false, false, false, false, false, false];
    in property <bool> memory-active: false;
    in property <bool> is-negative: false;
    in property <bool> has-error: false;
    in property <string> active-op: "";

    in-out property <bool> show-tape: false;
    in property <[TapeItem]> tape-entries: [];
    in-out property <int> theme-index: 0;
    in-out property <bool> sound-enabled: true;


    // Theme color resolver functions (0: Classic Olive, 1: Quartz Silver, 2: VFD Cyan, 3: Sinclair Ruby LED)
    pure function lcd_bg() -> color {
        root.theme-index == 1 ? #9ea7a6 :
        root.theme-index == 2 ? #061113 :
        root.theme-index == 3 ? #140305 : #899975
    }

    pure function active_ink() -> color {
        root.theme-index == 1 ? #0c1012 :
        root.theme-index == 2 ? #00f5d4 :
        root.theme-index == 3 ? #ff1a2a : #141c11
    }

    pure function ghost_ink() -> color {
        root.theme-index == 1 ? #8a9392 :
        root.theme-index == 2 ? #042926 :
        root.theme-index == 3 ? #3d070b : #788866
    }

    pure function cell_divider() -> color {
        root.theme-index == 1 ? #929c9b :
        root.theme-index == 2 ? #081d20 :
        root.theme-index == 3 ? #200709 : #82926e
    }

    pure function bezel_bg() -> color {
        root.theme-index == 1 ? #1a1c20 :
        root.theme-index == 2 ? #0b0f14 :
        root.theme-index == 3 ? #12090b : #1e221b
    }

    pure function bezel_border() -> color {
        root.theme-index == 1 ? #101216 :
        root.theme-index == 2 ? #04070a :
        root.theme-index == 3 ? #0a0406 : #121511
    }

    pure function casing_bg() -> color {
        root.theme-index == 1 ? #252830 :
        root.theme-index == 2 ? #161c24 :
        root.theme-index == 3 ? #1a1416 : #2b2e35
    }

    callback key-action(string);
    callback clear-tape();
    callback toggle-sound();
    callback toggle-tape();



    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == "0") { root.key-action("0"); accept; }
            else if (event.text == "1") { root.key-action("1"); accept; }
            else if (event.text == "2") { root.key-action("2"); accept; }
            else if (event.text == "3") { root.key-action("3"); accept; }
            else if (event.text == "4") { root.key-action("4"); accept; }
            else if (event.text == "5") { root.key-action("5"); accept; }
            else if (event.text == "6") { root.key-action("6"); accept; }
            else if (event.text == "7") { root.key-action("7"); accept; }
            else if (event.text == "8") { root.key-action("8"); accept; }
            else if (event.text == "9") { root.key-action("9"); accept; }
            else if (event.text == "." || event.text == ",") { root.key-action("."); accept; }
            else if (event.text == "+") { root.key-action("+"); accept; }
            else if (event.text == "-") { root.key-action("-"); accept; }
            else if (event.text == "*") { root.key-action("*"); accept; }
            else if (event.text == "/") { root.key-action("/"); accept; }
            else if (event.text == "%") { root.key-action("%"); accept; }
            else if (event.text == "=" || event.text == "\n") { root.key-action("="); accept; }
            else if (event.text == "c" || event.text == "C" || event.text == Key.Escape) { root.key-action("AC"); accept; }
            else if (event.text == Key.Backspace || event.text == Key.Delete) { root.key-action("CE"); accept; }
            else if (event.text == "t" || event.text == "T") { root.toggle-tape(); accept; }
            else { reject; }

        }

        HorizontalLayout {
            padding: 8px;
            spacing: 8px;

            // Pocket Calculator Outer Casing
            Rectangle {
                width: 314px;
                height: 100%;
                background: root.casing_bg();
                border-radius: 10px;
                border-width: 1.5px;
                border-color: #3e434d;

                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;
                    alignment: start;

                    // Header section: Brand badge, Theme toggle, Tape toggle & Solar Cell
                    HorizontalLayout {
                        height: 38px;
                        alignment: space-between;

                        // Brand Badge
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "HEPTASEG";
                                font-size: 15px;
                                font-weight: 900;
                                letter-spacing: 2px;
                                color: #d1d8e0;
                            }
                            Text {
                                text: "ELECTRONIC CALCULATOR";
                                font-size: 8px;
                                font-weight: 600;
                                letter-spacing: 1px;
                                color: #7b8896;
                            }
                        }

                        HorizontalLayout {
                            spacing: 5px;
                            alignment: center;

                            // Theme Selector Button
                            Rectangle {
                                width: 28px;
                                height: 26px;
                                background: ta-theme.pressed ? #4f46e5 : ta-theme.has-hover ? #475569 : #334155;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #475569;

                                Text {
                                    text: "🎨";
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                ta-theme := TouchArea {
                                    clicked => {
                                        root.theme-index = Math.mod(root.theme-index + 1, 4);
                                    }
                                }
                            }

                            // Sound Mute/Unmute Toggle Button
                            Rectangle {
                                width: 28px;
                                height: 26px;
                                background: ta-sound.pressed ? #4f46e5 : ta-sound.has-hover ? #475569 : #334155;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #475569;

                                Text {
                                    text: root.sound-enabled ? "🔊" : "🔇";
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                ta-sound := TouchArea {
                                    clicked => {
                                        root.toggle-sound();
                                    }
                                }
                            }

                            // Paper Tape Toggle Button

                            Rectangle {
                                width: 28px;
                                height: 26px;
                                background: root.show-tape ? #d97706 : (ta-tape.has-hover ? #475569 : #334155);
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.show-tape ? #f59e0b : #475569;

                                Text {
                                    text: "📜";
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                ta-tape := TouchArea {
                                    clicked => {
                                        root.toggle-tape();
                                    }
                                }
                            }

                            // Vintage Photovoltaic Solar Panel
                            Rectangle {
                                width: 68px;
                                height: 28px;
                                background: #141722;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #363c4e;

                                // Solar cell grid lines
                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 0px;
                                    for i in 4: Rectangle {
                                        width: 15.5px;
                                        height: 100%;
                                        border-width: 0.5px;
                                        border-color: #2b3244;
                                        background: #181c2b;
                                    }
                                }

                                // Glass gleam
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 50%;
                                    background: #ffffff;
                                    opacity: 0.04;
                                }
                            }
                        }
                    }

                    // LCD Screen Unit with dynamic theme bindings
                    LcdDisplay {
                        digits: root.digits;
                        decimals: root.decimals;
                        memory-active: root.memory-active;
                        is-negative: root.is-negative;
                        has-error: root.has-error;
                        active-op: root.active-op;
                        lcd-bg: root.lcd_bg();
                        active-ink: root.active_ink();
                        ghost-ink: root.ghost_ink();
                        cell-divider: root.cell_divider();
                        bezel-bg: root.bezel_bg();
                        bezel-border: root.bezel_border();
                    }

                    // Spacer
                    Rectangle {
                        height: 2px;
                    }

                    // Keypad Unit
                    Keypad {
                        key-pressed(key) => {
                            root.key-action(key);
                        }
                    }
                }
            }

            // Paper Tape Audit Roll Drawer (Visible when show-tape is active)
            if root.show-tape: PaperTape {
                width: 232px;
                height: 100%;
                entries: root.tape-entries;
                clear-tape => {
                    root.clear-tape();
                }
                close-tape => {
                    root.toggle-tape();
                }
            }
        }
    }
}

