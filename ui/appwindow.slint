import { LcdDisplay } from "lcd_display.slint";
import { Keypad } from "keypad.slint";
import { PaperTape } from "paper_tape.slint";

export component AppWindow inherits Window {
    title: "Heptaseg";
    icon: @image-url("");
    width: root.is-tape-open ? 590px : 330px;
    height: 490px;
    background: #23262b;
    default-font-family: "sans-serif";
    animate width { duration: 250ms; easing: ease-out; }

    in property <[string]> digits: [" ", " ", " ", " ", " ", " ", " ", "0"];
    in property <[bool]> decimals: [false, false, false, false, false, false, false, false];
    in property <bool> memory-active: false;
    in property <bool> is-negative: false;
    in property <bool> has-error: false;
    in property <string> active-op: "";

    // Display Theme Properties
    in property <color> lcd-bg: #899975;
    in property <color> active-ink: #141c11;
    in property <color> ghost-ink: #788866;
    in property <color> border-color: #82926e;
    in property <string> theme-name: "LCD OLIVE";



    callback cycle-theme();

    // Paper Tape Properties
    in-out property <bool> is-tape-open: false;
    in property <[string]> tape-lines: [];
    callback clear-tape();

    // Sound Properties
    in property <bool> is-muted: false;
    callback toggle-sound();

    // RPN Mode Properties
    in property <bool> is-rpn: false;
    callback toggle-mode();


    callback key-action(string);

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == "0") { root.key-action("0"); accept; }
            else if (event.text == "1") { root.key-action("1"); accept; }
            else if (event.text == "2") { root.key-action("2"); accept; }
            else if (event.text == "3") { root.key-action("3"); accept; }
            else if (event.text == "4") { root.key-action("4"); accept; }
            else if (event.text == "5") { root.key-action("5"); accept; }
            else if (event.text == "6") { root.key-action("6"); accept; }
            else if (event.text == "7") { root.key-action("7"); accept; }
            else if (event.text == "8") { root.key-action("8"); accept; }
            else if (event.text == "9") { root.key-action("9"); accept; }
            else if (event.text == "." || event.text == ",") { root.key-action("."); accept; }
            else if (event.text == "+") { root.key-action("+"); accept; }
            else if (event.text == "-") { root.key-action("-"); accept; }
            else if (event.text == "*") { root.key-action("*"); accept; }
            else if (event.text == "/") { root.key-action("/"); accept; }
            else if (event.text == "%") { root.key-action("%"); accept; }
            else if (event.text == "=" || event.text == "\n") { root.key-action("="); accept; }
            else if (event.text == "t" || event.text == "T") { root.is-tape-open = !root.is-tape-open; accept; }
            else if (event.text == "m" || event.text == "M") { root.cycle-theme(); accept; }
            else if (event.text == "s" || event.text == "S") { root.toggle-sound(); accept; }
            else if (event.text == "r" || event.text == "R") { root.toggle-mode(); accept; }
            else if (event.text == "c" || event.text == "C" || event.text == Key.Escape) { root.key-action("AC"); accept; }
            else if (event.text == Key.Backspace || event.text == Key.Delete) { root.key-action("CE"); accept; }
            else { reject; }
        }



        HorizontalLayout {
            padding: 8px;
            spacing: 8px;

            // Pocket Calculator Main Body
            Rectangle {
                width: 314px;
                height: 474px;
                background: #2b2e35;
                border-radius: 10px;
                border-width: 1.5px;
                border-color: #3e434d;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    alignment: start;

                    // Header section: Brand badge & Controls (Theme & Tape)
                    HorizontalLayout {
                        height: 38px;
                        alignment: space-between;

                        // Brand Badge
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "HEPTASEG";
                                font-size: 13px;
                                font-weight: 900;
                                letter-spacing: 2px;
                                color: #d1d8e0;
                            }
                            Text {
                                text: "ELECTRONIC CALCULATOR";
                                font-size: 6.5px;
                                font-weight: 600;
                                letter-spacing: 0.8px;
                                color: #7b8896;
                            }
                        }

                        // Header action buttons (THEME, TAPE) and Solar panel
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            // Theme switcher button
                            TouchArea {
                                width: 56px;
                                height: 22px;
                                clicked => { root.cycle-theme(); }
                                Rectangle {
                                    border-radius: 3px;
                                    background: parent.pressed ? #323842 : #22262e;
                                    border-width: 1px;
                                    border-color: #3d4654;
                                    Text {
                                        text: root.theme-name;
                                        font-size: 7px;
                                        font-weight: 800;
                                        letter-spacing: 0.3px;
                                        color: #9cb2c6;
                                    }
                                }
                            }

                            // Tape drawer toggle button
                            TouchArea {
                                width: 38px;
                                height: 22px;
                                clicked => { root.is-tape-open = !root.is-tape-open; }
                                Rectangle {
                                    border-radius: 3px;
                                    background: root.is-tape-open ? #3a4a58 : (parent.pressed ? #2d323c : #22262e);
                                    border-width: 1px;
                                    border-color: root.is-tape-open ? #5a7590 : #383f4d;
                                    Text {
                                        text: "TAPE";
                                        font-size: 7.5px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        color: root.is-tape-open ? #8fc5f8 : #8a96a3;
                                    }
                                }
                            }

                            // Sound toggle button
                            TouchArea {
                                width: 24px;
                                height: 22px;
                                clicked => { root.toggle-sound(); }
                                Rectangle {
                                    border-radius: 3px;
                                    background: parent.pressed ? #323842 : #22262e;
                                    border-width: 1px;
                                    border-color: #3d4654;
                                    Text {
                                        text: root.is-muted ? "🔇" : "🔊";
                                        font-size: 8px;
                                    }
                                }
                            }

                            // Vintage Photovoltaic Solar Panel
                            Rectangle {
                                width: 44px;
                                height: 24px;
                                background: #141722;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #363c4e;


                                // Solar cell grid lines
                                HorizontalLayout {
                                    padding: 1.5px;
                                    spacing: 0px;
                                    for i in 3: Rectangle {
                                        width: 16px;
                                        height: 100%;
                                        border-width: 0.5px;
                                        border-color: #2b3244;
                                        background: #181c2b;
                                    }
                                }

                                // Glass gleam
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 50%;
                                    background: #ffffff;
                                    opacity: 0.04;
                                }
                            }
                        }
                    }

                    // LCD Screen Unit
                    LcdDisplay {
                        digits: root.digits;
                        decimals: root.decimals;
                        memory-active: root.memory-active;
                        is-negative: root.is-negative;
                        has-error: root.has-error;
                        is-rpn: root.is-rpn;
                        active-op: root.active-op;
                        lcd-bg: root.lcd-bg;
                        active-ink: root.active-ink;
                        ghost-ink: root.ghost-ink;
                        panel-border: root.border-color;
                    }



                    // Spacer
                    Rectangle {
                        height: 2px;
                    }

                    // Keypad Unit
                    Keypad {
                        key-pressed(key) => {
                            root.key-action(key);
                        }
                    }
                }
            }

            // Expandable Paper Tape Drawer
            if (root.is-tape-open) : PaperTape {
                is-open: root.is-tape-open;
                tape-lines: root.tape-lines;
                close-tape => { root.is-tape-open = false; }
                clear-tape => { root.clear-tape(); }
            }
        }
    }
}
