// 7-segment LCD digit cell with authentic active and ghost segments (Orthogonal/Pixel-perfect).

export component LcdDigit inherits Rectangle {
    in property <string> digit-char: " ";
    in property <bool> has-decimal: false;
    in property <color> active-color: #141c11;
    in property <color> ghost-color: #788866;

    width: 24px;
    height: 40px;

    // Segment activation logic
    pure function seg_a(ch: string) -> bool {
        ch == "0" || ch == "2" || ch == "3" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9" || ch == "E"
    }
    pure function seg_b(ch: string) -> bool {
        ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "7" || ch == "8" || ch == "9"
    }
    pure function seg_c(ch: string) -> bool {
        ch == "0" || ch == "1" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9" || ch == "o"
    }
    pure function seg_d(ch: string) -> bool {
        ch == "0" || ch == "2" || ch == "3" || ch == "5" || ch == "6" || ch == "8" || ch == "9" || ch == "E" || ch == "o"
    }
    pure function seg_e(ch: string) -> bool {
        ch == "0" || ch == "2" || ch == "6" || ch == "8" || ch == "E" || ch == "r" || ch == "o"
    }
    pure function seg_f(ch: string) -> bool {
        ch == "0" || ch == "4" || ch == "5" || ch == "6" || ch == "8" || ch == "9" || ch == "E"
    }
    pure function seg_g(ch: string) -> bool {
        ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "8" || ch == "9" || ch == "-" || ch == "E" || ch == "r" || ch == "o"
    }

    // Segment A (Top: y from 2 to 6, x from 3 to 21)
    Path {
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 40;
        width: 100%;
        height: 100%;
        fill: seg_a(root.digit-char) ? root.active-color : root.ghost-color;
        commands: "M 3 2 L 21 2 L 17 6 L 7 6 Z";
    }

    // Segment B (Top-Right: x from 17 to 21, y from 3 to 19)
    Path {
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 40;
        width: 100%;
        height: 100%;
        fill: seg_b(root.digit-char) ? root.active-color : root.ghost-color;
        commands: "M 21 3 L 21 19 L 17 17 L 17 7 Z";
    }

    // Segment C (Bottom-Right: x from 17 to 21, y from 21 to 37)
    Path {
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 40;
        width: 100%;
        height: 100%;
        fill: seg_c(root.digit-char) ? root.active-color : root.ghost-color;
        commands: "M 21 21 L 21 37 L 17 33 L 17 23 Z";
    }

    // Segment D (Bottom: y from 34 to 38, x from 3 to 21)
    Path {
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 40;
        width: 100%;
        height: 100%;
        fill: seg_d(root.digit-char) ? root.active-color : root.ghost-color;
        commands: "M 3 38 L 21 38 L 17 34 L 7 34 Z";
    }

    // Segment E (Bottom-Left: x from 3 to 7, y from 21 to 37)
    Path {
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 40;
        width: 100%;
        height: 100%;
        fill: seg_e(root.digit-char) ? root.active-color : root.ghost-color;
        commands: "M 3 21 L 7 23 L 7 33 L 3 37 Z";
    }

    // Segment F (Top-Left: x from 3 to 7, y from 3 to 19)
    Path {
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 40;
        width: 100%;
        height: 100%;
        fill: seg_f(root.digit-char) ? root.active-color : root.ghost-color;
        commands: "M 3 3 L 7 7 L 7 17 L 3 19 Z";
    }

    // Segment G (Middle: Hexagon centered at y=20)
    Path {
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 40;
        width: 100%;
        height: 100%;
        fill: seg_g(root.digit-char) ? root.active-color : root.ghost-color;
        commands: "M 4 20 L 7 18 L 17 18 L 20 20 L 17 22 L 7 22 Z";
    }

    // Decimal Point (DP)
    Rectangle {
        x: 21.5px;
        y: 35.0px;
        width: 3.0px;
        height: 3.0px;
        border-radius: 0px;
        background: root.has-decimal ? root.active-color : root.ghost-color;
    }










}
